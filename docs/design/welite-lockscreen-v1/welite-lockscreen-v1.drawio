        <mxCell id="specification-7" value="阅读 / 书架" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=1;fontColor=#111111;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="228" width="268" height="30" as="geometry" />
        </mxCell>
        <mxCell id="specification-8" value="保持当前页面" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="266" width="268" height="24" as="geometry" />
        </mxCell>
        <mxCell id="specification-9" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=1;absoluteArcSize=1;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="450" y="216" width="300" height="92" as="geometry" />
        </mxCell>
        <mxCell id="specification-10" value="WeLite 锁屏" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=1;fontColor=#111111;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="466" y="228" width="268" height="30" as="geometry" />
        </mxCell>
        <mxCell id="specification-11" value="展示休眠前的数据" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="466" y="266" width="268" height="24" as="geometry" />
        </mxCell>
        <mxCell id="specification-12" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=1;absoluteArcSize=1;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="852" y="216" width="300" height="92" as="geometry" />
        </mxCell>
        <mxCell id="specification-13" value="恢复原页面" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=1;fontColor=#111111;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="868" y="228" width="268" height="30" as="geometry" />
        </mxCell>
        <mxCell id="specification-14" value="保持原来的阅读位置" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="868" y="266" width="268" height="24" as="geometry" />
        </mxCell>
        <mxCell id="specification-15" value="进入休眠" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#111111;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="specification-6" target="specification-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="specification-16" value="电源键唤醒" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#111111;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="specification-9" target="specification-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="specification-17" value="入口：WeLite 设置 → 基础设置 → 锁屏设置。预览使用同一版式，轻点任意位置返回设置。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=0;fontColor=#111111;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="330" width="1104" height="35" as="geometry" />
        </mxCell>
        <mxCell id="specification-18" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BBBBBB;strokeWidth=1;absoluteArcSize=1;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="48" y="398" width="536" height="145" as="geometry" />
        </mxCell>
        <mxCell id="specification-19" value="01  保持同一套视觉语言" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#111111;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="415" width="492" height="30" as="geometry" />
        </mxCell>
        <mxCell id="specification-20" value="沿用 WeLite 字标、白底黑字与 1 px 分隔线。&#10;左右留白 24 px，书名和关键数值加粗。&#10;只有设置使用圆角白色面板与灰色遮罩。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="455" width="492" height="73" as="geometry" />
        </mxCell>
        <mxCell id="specification-21" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BBBBBB;strokeWidth=1;absoluteArcSize=1;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="616" y="398" width="536" height="145" as="geometry" />
        </mxCell>
        <mxCell id="specification-22" value="02  只聚焦一本最近阅读" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#111111;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="638" y="415" width="492" height="30" as="geometry" />
        </mxCell>
        <mxCell id="specification-23" value="阅读中休眠展示当前书；书架休眠展示最近阅读书。&#10;呈现封面、书名、作者、当前章节与全书进度。&#10;时长沿用书架的本月 / 本周 / 今日顺序。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="638" y="455" width="492" height="73" as="geometry" />
        </mxCell>
        <mxCell id="specification-24" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BBBBBB;strokeWidth=1;absoluteArcSize=1;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="48" y="567" width="536" height="145" as="geometry" />
        </mxCell>
        <mxCell id="specification-25" value="03  本地数据与休眠快照" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#111111;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="584" width="492" height="30" as="geometry" />
        </mxCell>
        <mxCell id="specification-26" value="复用现有阅读位置与时长数据口径，不单独估算。&#10;休眠前保存本次阅读记录，再生成一次锁屏。&#10;不显示时钟与日期，不联网、不轮询、不定时刷新。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="624" width="492" height="73" as="geometry" />
        </mxCell>
        <mxCell id="specification-27" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BBBBBB;strokeWidth=1;absoluteArcSize=1;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="616" y="567" width="536" height="145" as="geometry" />
        </mxCell>
        <mxCell id="specification-28" value="04  内容不足时的降级" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#111111;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="638" y="584" width="492" height="30" as="geometry" />
        </mxCell>
        <mxCell id="specification-29" value="无封面使用同尺寸的书名封面；长书名最多两行。&#10;未知进度显示“暂无进度”，不填充进度条。&#10;时长缺失显示“—”；确认没有阅读才显示“0 分钟”。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="638" y="624" width="492" height="73" as="geometry" />
        </mxCell>
        <mxCell id="specification-30" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BBBBBB;strokeWidth=1;absoluteArcSize=1;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="48" y="736" width="536" height="145" as="geometry" />
        </mxCell>
        <mxCell id="specification-31" value="05  显示选项与首次使用" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#111111;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="753" width="492" height="30" as="geometry" />
        </mxCell>
        <mxCell id="specification-32" value="建议三个开关默认开启。关闭最近阅读后隐藏整块书籍&#10;与进度；关闭时长后隐藏本书累计与三列统计。&#10;尚未开始阅读使用第 02 页；始终保留唤醒提示。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="793" width="492" height="73" as="geometry" />
        </mxCell>
        <mxCell id="specification-33" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BBBBBB;strokeWidth=1;absoluteArcSize=1;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="616" y="736" width="536" height="145" as="geometry" />
        </mxCell>
        <mxCell id="specification-34" value="06  休眠行为的范围" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#111111;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="638" y="753" width="492" height="30" as="geometry" />
        </mxCell>
        <mxCell id="specification-35" value="拟接入 KOReader 的休眠与唤醒流程。&#10;真休眠下不安排点击按钮；唤醒仍使用设备电源键。&#10;本稿不新增密码锁，也不改变 Kindle 系统锁屏策略。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="638" y="793" width="492" height="73" as="geometry" />
        </mxCell>
        <mxCell id="specification-36" value="样式标尺" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#111111;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="920" width="160" height="28" as="geometry" />
        </mxCell>
        <mxCell id="specification-37" value="正文 16–17 px  /  说明 14 px  /  分组标题 20 px  /  书名 32 px  /  统计 23 px" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=0;fontColor=#555555;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="957" width="1104" height="26" as="geometry" />
        </mxCell>
        <mxCell id="specification-38" value="适配约定：按屏幕尺寸缩放，保留相对留白；长章节单行省略。设计文件全部使用可编辑文字与矢量形状。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;strokeColor=none;fillColor=none;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="998" width="1104" height="28" as="geometry" />
